# ── ZestQA Platform (Supabase) ────────────────────────────
# This is the central platform backend — it holds the service role key,
# which bypasses row-level security for every user. Keep it here only,
# never on a customer-facing HuggingFace Space.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ── Agent provisioning (/platform/provision-agent) ────────
# HF_TOKEN needs write access to create Spaces under HF_USERNAME.
# VERCEL_TOKEN needs access to create projects in your Vercel account.
HF_TOKEN=hf_your-write-token
HF_USERNAME=sarimsikander
VERCEL_TOKEN=your-vercel-token
