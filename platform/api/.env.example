# ── ZestQA Platform (Supabase) ────────────────────────────
# This is the central platform backend — it holds the service role key,
# which bypasses row-level security for every user. Keep it here only,
# never on a customer-facing HuggingFace Space.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key
